node_modules/
.expo/
dist/
.env
*.log

# The packed web build, produced by `npm run bundle` from the web app in
# `../src`. Generated, never committed — but it MUST exist before a build or the
# wrapper ships with no hourglass inside it. The root `.easignore` is what
# keeps it in the EAS upload; CI regenerates it (see
# .github/workflows/native.yml).
assets/webroot.zip

# Generated by `expo prebuild`. Regenerated from app.config.js and the config
# plugins, so it is the source of truth for nothing.
#
# Anchored to this directory, as the sibling apps keep them.
/ios/
/android/

# Store credentials — never committed.
*.p8
*.p12
*.jks
*.mobileprovision
play-service-account.json
